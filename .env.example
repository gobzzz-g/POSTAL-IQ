# POSTALIQ Environment Configuration Placeholder Template
# Copy this file to .env and adjust variables for your target deployment

# Project
PROJECT_NAME=POSTALIQ
VERSION=1.0.0
ENV=development
DEBUG=true

# Security
SECRET_KEY=postaliq-dev-secret-key-super-secure-change-in-production-12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default: Local SQLite for rapid local demonstration
DATABASE_URL=sqlite:///./postaliq.db
# PostgreSQL Production Example:
# DATABASE_URL=postgresql://postaliq_user:postaliq_pass@localhost:5432/postaliq

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# Frontend API Base URL
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Postal Dataset Paths
DATASET_PATH=./data/india_post_master.csv
MODEL_ARTIFACTS_DIR=./backend/artifacts

# Rate Limiting & Performance
RATE_LIMIT_PER_MINUTE=120

# Initial Confidence Thresholds
CONFIDENCE_HIGH_THRESHOLD=0.85
CONFIDENCE_MEDIUM_THRESHOLD=0.70
CONFIDENCE_MIN_THRESHOLD=0.30

# Default Admin User
ADMIN_USERNAME=admin
ADMIN_PASSWORD=PostalIQ@2025Secure
